{
	"name": "betterhermosa",
	"compatibility_date": "2026-01-13",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "betterhermosa.org",
			"custom_domain": true
		}
	],
	"vars": {
		"GITHUB_REPO": "BetterHermosa/betterhermosa",
	}
}